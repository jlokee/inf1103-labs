def get_valid_input():
    product = input("Enter Product Name: ")
    if product.lower() == "quit":
        return "quit", 0
    elif product == "Wireless Mouse" or product == "Keyboard" or product == "USB Cable" or product == "Laptop Stand":
        quantity = input("Enter Quantity: ")
        if quantity.isdigit():
            return product, int(quantity)
        

