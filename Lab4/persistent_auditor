quantity = 0
product = ""
orderid = 0
order = []


def get_valid_input():
    valid_products = ["Wireless Mouse", "Keyboard", "USB Cable", "Laptop Stand"]
    while True:
        product = input("Enter Product Name: ")
        if product.lower() == "quit":
            return "quit", 0
        elif product in valid_products:
            quantity = input("Enter Quantity: ")
            if quantity.isdigit():
                return product, int(quantity)
            else:
                print("Invalid quantity. Please enter a whole number.")
        else:
            print("Invalid product name. Please try again.")
        

def load_inventory_from_file():
    global orderid
    print("Current Inventory:\n")
    
    with open("Lab4/inventory.txt", 'r') as file:
        # Strip lines and keep only non-empty ones
        lines = [line.strip() for line in file if line.strip()]
    
    # Slice the list to get up to the last 3 lines
    last_three = lines[-3:]
    
    for line in last_three:
        print(line)
        parts = line.split(',')
        oid = int(parts[0].strip())
        if oid > orderid:
            orderid = oid
    print()

def new_order(oid, prod, qty):
    print("\nNew Order Added:\n")
    print(f"{oid},{prod},{qty}\n")

def save_orders_to_file():
    if not order:
        print("No new orders to save.")
        return
    with open("Lab4/inventory.txt", 'a') as file:
        for oid, prod, qty in order:
            file.write(f"\n{oid}, {prod}, {qty}")
    print("Orders succesfully saved to orders.txt")
    

load_inventory_from_file()
while True:
    product, quantity = get_valid_input()
    if product == "quit":
        save_orders_to_file()
        break
    else:
        orderid += 1
        order.append((orderid, product, quantity))
        new_order(orderid, product, quantity)